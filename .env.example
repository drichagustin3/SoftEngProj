# Copy to .env only when you do not already have one.
NODE_ENV=development
PORT=3000

# PostgreSQL installed directly on your computer/Codespace; no Docker required.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hopedb
DB_USER=hope_app
DB_PASSWORD=replace_with_your_database_password

# Generate a value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_generated_secret
JWT_EXPIRES_IN=1d
